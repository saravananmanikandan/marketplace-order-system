DJANGO_SECRET_KEY="dev-only-django-secret-key-change-me-0001"
DJANGO_DEBUG="true"
UBER_CLIENT_SECRET="dev-uber-client-secret-0001"
DOORDASH_WEBHOOK_AUTH_HEADER="Bearer dev-doordash-token-0001"
UBER_GET_ORDER_FIXTURE="fixtures/uber_get_order.json"
DEFAULT_CURRENCY="USD"
PAGE_SIZE="20"
UBER_API_BASE="https://api.uber.com"
UBER_ACCESS_TOKEN="dev-uber-access-token-0001"
API_PROXY_TARGET="http://localhost:8000"

# Demo-only tools (api/demo/, admin/src/demo/). Set DEMO_ENABLED="false" and
# delete the UBER_ORDER_CLIENT line below to run the plain assignment code.
DEMO_ENABLED="true"
UBER_ORDER_CLIENT="demo.clients.StagedOrderClient"
# To exercise the real HTTP path against the local demo mock instead, use:
# UBER_ORDER_CLIENT="orders.providers.uber.HttpOrderClient"
# UBER_API_BASE="http://localhost:8000/demo/mock/uber"
# (any non-empty UBER_ACCESS_TOKEN works, because the mock checks this same value)
